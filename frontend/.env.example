# Only needed when the UI runs in a normal browser (`npm run dev`, no Electron) and the
# engine was started by hand (docs/desktop-contract.md §8 "Engine alone").
# Inside MetisClip Desktop the engine URL and per-launch token come from window.metis.
# Copy to .env.local (gitignored). Never put API keys here: they live in the engine's
# secret store (Windows Credential Manager) and are entered in Pengaturan.
NEXT_PUBLIC_ENGINE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ENGINE_TOKEN=dev-token
